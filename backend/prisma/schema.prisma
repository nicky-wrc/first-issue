generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SkillLevel {
  beginner
  intermediate
  advanced
}

enum BookmarkStatus {
  interested
  applying
  submitted
}

model User {
  id         String     @id @default(cuid())
  githubId   String     @unique
  username   String
  avatarUrl  String?
  email      String?
  languages  String[]   @default([])
  skillLevel SkillLevel @default(beginner)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  bookmarks  Bookmark[]
  digestLogs DigestLog[]
}

model Bookmark {
  id          String         @id @default(cuid())
  userId      String
  issueUrl    String
  issueTitle  String
  repoName    String
  language    String?
  status      BookmarkStatus @default(interested)
  matchScore  Int?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, issueUrl])
  @@index([userId])
}

model AiAnalysis {
  id            String   @id @default(cuid())
  issueUrl      String   @unique
  summary       String
  skillsNeeded  String[] @default([])
  difficulty    String
  score         Int
  cachedAt      DateTime @default(now())

  @@index([cachedAt])
}

model DigestLog {
  id         String    @id @default(cuid())
  userId     String
  sentAt     DateTime  @default(now())
  issueCount Int
  openedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
}
