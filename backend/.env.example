# Server
PORT=4000
FRONTEND_URL="http://localhost:3000"

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/first_issue?schema=public"

# GitHub PAT for GraphQL (repo + read:user)
GITHUB_TOKEN=""

# Claude API
ANTHROPIC_API_KEY=""

# Upstash Redis (optional)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Resend email (phase 5)
RESEND_API_KEY=""

# Cron protection
CRON_SECRET="generate-with-openssl-rand-base64-32"

# Must match frontend INTERNAL_API_KEY
INTERNAL_API_KEY="generate-with-openssl-rand-base64-32"
